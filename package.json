{
  "name": "crow",
  "version": "2.0.0",
  "private": false,
  "license": "AGPL-3.0-or-later",
  "description": "Crow — a privacy-first, end-to-end-encrypted messenger that runs entirely as a static app.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"docs/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"docs/*.md\"",
    "relays:probe": "node scripts/probe-relays.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "icons": "node scripts/generate-icons.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "rotate:workflow": "node scripts/rotateWorkflow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.4.3",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.3.3",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.4.3",
    "@scure/base": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "^1.48.0",
    "next": "^15.5.0",
    "nostr-tools": "2.25.0",
    "qr": "^0.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^1.7.0",
    "tailwind-merge": "^3.7.0",
    "ts-mls": "1.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.21",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.15",
    "postcss": "^8.5.0",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
